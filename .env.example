# ===== MySQL (dùng chung máy chủ, mỗi dịch vụ một database riêng, tự tạo khi chạy lần đầu) =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456

# ===== Bảo mật =====
# Bắt buộc. Dùng chuỗi dài, ngẫu nhiên.
JWT_SECRET=doi_chuoi_nay_thanh_chuoi_bi_mat_dai_ngau_nhien
# Tùy chọn: khóa nội bộ giữa các dịch vụ (mặc định suy ra từ JWT_SECRET)
# INTERNAL_KEY=
# Tài khoản admin được tạo lần đầu nếu chưa có admin nào
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# ===== Cổng (tùy chọn, đây là giá trị mặc định) =====
# GATEWAY_PORT=3000
# REGISTRY_PORT=3500
# EVENT_BUS_PORT=3600
